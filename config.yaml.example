      email: richard@jrsretailservices.com
      first_name: Richard
      last_name: Bodington
      password: $2b$12$EJEMPLO_HASH_BCRYPT_FICTICIO_NO_REAL_xxxxxxxxxxxxxxxxx
      failed_login_attempts: 0
      logged_in: false
