# config.yaml.example — PLANTILLA (esta SI sube al repo)
# El config.yaml real (con hashes bcrypt reales) NO sube a git: va al .gitignore.
# Genera el real con:  python generar_config.py
#
# Estructura esperada por Streamlit-Authenticator 0.4.2:

cookie:
  name: jrs_dashboard_auth
  key: REEMPLAZAR_CON_CLAVE_ALEATORIA   # generar_config.py la genera automaticamente
  expiry_days: 7

credentials:
  usernames:
